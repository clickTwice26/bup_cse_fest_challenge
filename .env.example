# Copy to .env and fill in. NEVER commit .env
# Primary interpreter provider (Groq - https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Backup provider (Google AI Studio - https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

PORT=8000
LLM_TIMEOUT_SECONDS=6

# Provider order: first entry carries normal traffic.
LLM_PROVIDER_ORDER=gemini,groq,xai
GROQ_REASONING_EFFORT=low
GEMINI_REASONING_EFFORT=none
